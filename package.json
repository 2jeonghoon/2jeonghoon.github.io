{
  "homepage": "https://2jeonghoon.github.io",
  "name": "developerfolio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "colorthief": "2.3.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "jest-canvas-mock": "^2.3.1",
    "js-yaml": "3.14.1",
    "lottie-react": "^2.4.0",
    "react": "^16.10.2",
    "react-dom": "^16.10.2",
    "react-easy-emoji": "^1.8.1",
    "react-headroom": "^3.0.0",
    "react-reveal": "^1.2.2",
    "react-scripts": "^3.0.1",
    "react-test-renderer": "^16.10.2",
    "react-twitter-embed": "3.0.3",
    "sass": "^1.32.8"
  },
  "scripts": {
    "predeploy": "npm run build",
    "start": "node fetch.js && NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "node fetch.js && NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "deploy": "gh-pages -d build",
    "test": "react-scripts test",
    "test:blog": "node --test test/*.test.mjs",
    "test:admin": "node --test test/admin-*.test.mjs",
    "build:blog": "node scripts/build-blog.mjs",
    "dev:admin": "wrangler dev --config worker/wrangler.toml",
    "deploy:admin": "wrangler deploy --config worker/wrangler.toml",
    "validate:blog": "node --test test/*.test.mjs && node scripts/build-blog.mjs",
    "eject": "react-scripts eject",
    "format": "prettier --write \"./**/*.{js,css,json,scss}\"",
    "check-format": "prettier -c \"./**/*.{js,css,json,scss}\""
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "commander": "^7.0.0",
    "dotenv": "^8.2.0",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "prettier": "^2.3.1",
    "wrangler": "4.36.0"
  },
  "overrides": {
    "enzyme": {
      "cheerio": "1.0.0-rc.12"
    }
  }
}
